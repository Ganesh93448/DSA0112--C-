class Person {
protected:
    int id;
    string name, phone, email;

public:
    Person() : id(0), name(""), phone(""), email("") {}
    Person(int i, const string& n, const string& p, const string& e)
        : id(i), name(n), phone(p), email(e) {}
    Person(const Person& other)
        : id(other.id), name(other.name), phone(other.phone), email(other.email) {}
    virtual ~Person() = default;

    int getId() const { return id; }
    string getName() const { return name; }

    virtual void display() const {
        cout << "ID: " << id << " | Name: " << name
             << " | Phone: " << phone << " | Email: " << email << '\n';
    }
};

class Guest : public virtual Person {
public:
    Guest() : Person() {}
    Guest(int i, const string& n, const string& p, const string& e)
        : Person(i, n, p, e) {}

    void display() const override {
        cout << "Guest - ";
        Person::display();
    }
};

class LoyaltyMember : public virtual Person {
protected:
    int loyaltyPoints;

public:
    LoyaltyMember() : Person(), loyaltyPoints(0) {}
    explicit LoyaltyMember(int points) : Person(), loyaltyPoints(points) {}

    void addPoints(int p) { loyaltyPoints += p; }
    int getPoints() const { return loyaltyPoints; }
};

class VIPGuest : public Guest, public LoyaltyMember {
public:
    VIPGuest() : Person(), Guest(), LoyaltyMember() {}

    VIPGuest(int i, const string& n, const string& p,
             const string& e, int points)
        : Person(i, n, p, e), Guest(i, n, p, e), LoyaltyMember(points) {}

    void display() const override {
        cout << "VIP Guest - ";
        Person::display();
 
        cout << "Loyalty Points: " << loyaltyPoints << '\n';
    }
};

class Room {
protected:
    int roomNumber;
    bool available;

public:
    Room(int number = 0) : roomNumber(number), available(true) {}
    Room(const Room& r)
        : roomNumber(r.roomNumber), available(r.available) {}
    virtual ~Room() {}

    int getRoomNumber() const { return roomNumber; }
    bool isAvailable() const { return available; }
    void setAvailable(bool a) { available = a; }

    virtual string getType() const = 0;
    virtual double getRate() const = 0;
    virtual void display() const = 0;
};

class StandardRoom : public Room {
public:
    StandardRoom(int n = 0) : Room(n) {}
    string getType() const override { return "Standard"; }
    double getRate() const override { return 2500.0; }

    void display() const override {
        cout << roomNumber << " | Standard | Rs."
             << fixed << setprecision(2) << getRate() << " | "
             << (available ? "Available" : "Occupied") << '\n';
    }
};

class DeluxeRoom : public Room {
public:
    DeluxeRoom(int n = 0) : Room(n) {}
    string getType() const override { return "Deluxe"; }
    double getRate() const override { return 4000.0; }

    void display() const override {
        cout << roomNumber << " | Deluxe | Rs."
             << fixed << setprecision(2) << getRate() << " | "
             << (available ? "Available" : "Occupied") << '\n';
    }
};

class SuiteRoom : public Room {
